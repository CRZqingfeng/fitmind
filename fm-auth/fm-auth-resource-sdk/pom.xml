<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fm-auth</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-auth-resource-sdk</artifactId>
    <description>资源服务鉴权 SDK：各业务服务引入后自动解析用户信息到 UserContext</description>

    <dependencies>
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-auth-common</artifactId>
        </dependency>

        <!--
          可选：管理端鉴权拦截器需要 UserClient（查询用户类型）。
          ★ 必须是 optional —— 本 SDK 的使用方自己都会引 fm-api（它们要用别的客户端），
            这里只是为了让"这个类能编译"和"能注入到 UserClient"成立。
            声明成 optional 就不会向下传递，避免 SDK 反过来决定使用方的依赖集。
          （无循环风险：fm-api 只依赖 fm-common，不依赖任何 fm-auth-* 模块。）
        -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 业务服务为 Servlet 技术栈 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 可选：仅当使用方引入 Feign 时，才装配用户信息透传拦截器 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
