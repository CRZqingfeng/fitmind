<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fitmind</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-api</artifactId>
    <description>服务间调用契约：Feign Client、DTO、降级 Fallback、公共缓存</description>

    <dependencies>
        <!-- 公共模块 -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-common</artifactId>
        </dependency>

        <!-- OpenFeign：标为 provided，由使用方（业务服务）引入 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 参数校验注解，用于 DTO -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          ★ P0-5 熔断：让 7 个 fallbackFactory 真正生效。
          为什么必须有它：Spring Cloud OpenFeign 的 fallback 触发条件是
          「classpath 上有 CircuitBreaker 实现」+「openfeign.circuitbreaker.enabled=true」，
          此前两个条件都不满足 —— 7 个降级工厂编译通过、启动正常、永不执行。

          为什么放在 fm-api 而不是 fm-common：
          网关只依赖 fm-auth-gateway-sdk → fm-auth-common，不依赖 fm-api，
          因此 resilience4j + AOP 不会被拖进 WebFlux 网关。
          版本由根 pom 的 spring-cloud-dependencies 统一管理，不写 version。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- 接口文档注解 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
    </dependencies>
</project>
