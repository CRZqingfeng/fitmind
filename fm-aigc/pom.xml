<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ============================================================================
      ★★ 本模块是全项目唯一「自己的 parent 不是 fitmind」的模块 —— 这是 M6-0 spike 的产物。

      背景：Spring AI 1.0/1.1 GA 要求 Spring Boot 3.4+（官方文档：支持 3.4.x / 3.5.x），
            而全项目基线是 Spring Boot 3.3.5（14 个服务、788 项验收都在那上面）。
            常见实现用的是 Spring AI 1.0.0-M6（2025-03 里程碑版）+ Boot 3.3.5。

      取舍：把「升级」的影响面**限制在这一个模块内**，而不是让 15 个服务一起承担。
            Spring Cloud 各服务之间只通过 HTTP + Nacos 交互，没有编译期耦合，
            所以「一个服务用新版本、其余不动」在架构上是成立的。

      ⚠️ 为什么 parent 必须是 spring-boot-starter-parent 而不是 fitmind：
          fitmind 的父链是 spring-boot-starter-parent 3.3.5，它**直接声明**了
          spring-boot-starter-* 的版本（版本号来自它自己的 project.version）。
          而在子模块里 import 的 BOM，**优先级低于父链继承下来的直管条目** ——
          实测结果：子 pom 里 import 了 spring-boot-dependencies:3.5.16，
          解析出来 spring-boot-starter-web 仍然是 3.3.5、spring-framework 仍是 6.1.14。
          混用「3.5 的 starter + 6.1 的 framework」必然炸，且炸在运行期。
          → 所以要让整个依赖管理一致，只能换 parent。

      ⚠️ 代价（必须知道）：本模块不继承 fitmind 的 dependencyManagement，
          所以下面要自己声明内部模块版本与那几个公共依赖的版本。
          新增依赖时记得同步维护 —— 这是"版本独立"的必然成本。
      ============================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <!-- ⚠️ 必须是空：默认会去 ../pom.xml 找 parent，那是 fitmind -->
        <relativePath/>
    </parent>

    <groupId>com.fitmind</groupId>
    <artifactId>fm-aigc</artifactId>
    <version>1.0.0</version>
    <description>AI 健身教练：多 Agent 路由 + Tool Calling + RAG + SSE 流式 + 会话记忆</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 项目内共享模块（不继承 fitmind，故显式声明版本） -->
        <fitmind.version>1.0.0</fitmind.version>
        <!-- Spring 生态版本组合（Boot / Cloud / Alibaba 必须同代，见上） -->
        <aigc.cloud.version>2025.0.3</aigc.cloud.version>
        <aigc.alibaba.version>2025.0.0.0</aigc.alibaba.version>
        <aigc.spring-ai.version>1.1.8</aigc.spring-ai.version>
        <!-- 公共依赖（原由 fitmind 管理，这里自管） -->
        <hutool.version>5.8.36</hutool.version>
        <swagger.version>2.2.19</swagger.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <!--
          ★ M6-3 新增：ES 客户端版本必须和服务端同线（服务端是 7.17.22）。
          ⚠️ 这个属性必须在这里**自己声明**：本模块的 parent 是 spring-boot-starter-parent，
          Boot 3.5 的 BOM 把 ES 相关坐标管到了 8.x/9.x 线。
          用 8.x 的客户端连 7.17 服务端不是"编译不过"，而是**运行期查询语法不被支持**
          （8.x 的 knn 检索在 7.x 上不存在）—— 又是一个"能编译、炸在运行期"的坑。
        -->
        <elasticsearch.version>7.17.10</elasticsearch.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${aigc.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${aigc.alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${aigc.spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- MyBatis-Plus：会话与消息落库（M6-1 起） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 公共依赖：fm-common / fm-api 传递进来的，需要有版本兜底 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <!--
              ES 客户端：**必须在这里显式锁定版本**。
              spring-boot-starter-parent 3.5.16 的 BOM 把 org.elasticsearch.client
              管到了 8.x 线，而我们的服务端是 7.17.22。
              子 pom 自己的 dependencyManagement **优先于**父链继承下来的条目，
              所以这三行就是"把版本拽回 7.17"的唯一开关。
            -->
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-high-level-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 项目内共享模块（用 Boot 3.3.5 编译，此处验证运行期兼容性 = spike 第 4 项） -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-common</artifactId>
            <version>${fitmind.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-api</artifactId>
            <version>${fitmind.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-auth-resource-sdk</artifactId>
            <version>${fitmind.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ⚠️ 换 parent 的连带成本：原 fitmind 里全局声明了 lombok，
             spring-boot-starter-parent 不含它，必须自己加（版本由 Boot BOM 管） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ⚠️ 新模块立项四项：openfeign + loadbalancer 必须显式引（fm-api 对它是 provided） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ★ Spring AI：chat 与 embedding 都走 OpenAI 兼容协议（见方案 §十五 D2/D4） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- ==================== M6-1 起需要的能力 ==================== -->

        <!-- 会话与消息落库 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 3.5.9 起 jsqlparser 被拆出来，分页/解析相关要用得单独引 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!--
          ⚠️ 驱动坐标和别的服务不一样：其余 14 个服务用的是老的
          `mysql:mysql-connector-java`（由 fitmind 父 pom 管版本），
          而 Spring Boot 3.4+ 的 BOM 管理的已经是新坐标 `com.mysql:mysql-connector-j`。
          本模块换 parent 后要走新的那一套 —— 用旧坐标会报
          `'dependencies.dependency.version' ... is missing`，
          因为新 BOM 里根本没有它的版本号。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!--
          Redis 在本模块有三个用途（不是"顺便引一下"）：
          ① 会话热消息（M6-5：Redis List 存最近 N 轮，MySQL 只存元数据与全量历史）
          ② 分布式打断标记（M6-5：ai:generating:{sessionId}:{requestId}，带 TTL）
          ③ ★ Mock 通道记录 prompt 快照（M6-1 就要）—— 让验收脚本能断言
             "RAG 检索到的文档确实进了 prompt"，而不是只看模型输出
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JSON 列（chat_message.tool_calls / params）用 JacksonTypeHandler 映射 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 本模块无定时任务 → 不引 xxl-job-core（知识库重建走管理端接口手动触发） -->

        <!-- ==================== M6-3 RAG：向量检索底座 ==================== -->

        <!--
          Spring AI 的 VectorStore / SearchRequest / Filter DSL 定义在这里。
          ⚠️ 它**不是** spring-ai-starter-model-openai 的传递依赖 ——
          starter 只负责"模型通道"，向量抽象是独立模块，所以必须显式引。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!--
          ★ 这里**没有**用官方的 spring-ai-starter-vector-store-elasticsearch，原因很实在：
          它的实现依赖 ES 8.x 的 **knn 检索**（`knn` 顶层查询），
          而本项目的 ES 服务端是 7.17.22（fm-search 就在上面跑，动不了）。
          7.17 只有 `script_score` + `cosineSimilarity` 这条路。
          用官方 starter 的结果会是"依赖装上了、代码编译过了、一查就报 unknown field [knn]" ——
          典型的运行期炸。
          → 所以这里自己做 VectorStore 实现（见 ElasticsearchVectorStore），
            用 7.17 的 RestHighLevelClient + script_score。
            好消息是：实现的是 Spring AI 的**接口本身**，将来换 Milvus / pgvector
            只需要换一个 Bean，上层（Advisor / Agent / 检索服务）一行都不用改。
        -->
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-high-level-client</artifactId>
        </dependency>
        <!-- 显式引 rest-client 与 es 内核：防止别的依赖把版本又拉回 8.x -->
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch</groupId>
            <artifactId>elasticsearch</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              ⚠️ 必须显式声明：spring-boot-starter-parent 只在 pluginManagement 里
              配置了这个插件（版本），**放到 build/plugins 里才会真正执行 repackage**。
              漏了它的表现很隐蔽：构建成功，但产物只有几 KB ——
              因为打出来的是普通 jar，不是可执行的 fat jar，启动时必然找不到主类。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
