<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fitmind</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-pay</artifactId>
    <description>支付服务：支付单、支付渠道抽象、Mock 渠道、支付结果回调</description>

    <dependencies>
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-auth-resource-sdk</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ⚠️ 新模块立项四项之一：依赖 fm-api 就必须引 openfeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- ⚠️ 新模块立项四项之二：Spring Cloud 2020 起 openfeign 不再自带它 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 支付结果通知交易模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ★ M4-4 新增：退款在途对账任务需要 XXL-JOB 执行器。
             ⚠️ fm-common 对 xxl-job-core 用的是 provided（不传递），
             所以这里必须显式引入 —— 否则 application.yml 里那段 xxl.job 配置
             会变成"死配置"：不报错、不生效、也看不出问题。
             （本项目 M4-2 时 fm-pay 就是这样：yml 里配了执行器，
               实际上从未注册到调度中心，因为没有这个依赖。） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job-version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
