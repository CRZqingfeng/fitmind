<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fitmind</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-search</artifactId>
    <description>搜索服务：ES 全文检索（IK 中文分词）、榜单推荐、用户兴趣（MQ 同步索引）</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-common</artifactId>
        </dependency>
        <!-- 跨服务契约：CourseClient / UserClient 拿课程与教练数据 -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-api</artifactId>
        </dependency>
        <!-- 资源服务鉴权 SDK：自动把网关透传的用户信息放入 UserContext -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-auth-resource-sdk</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 接口文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- 服务注册发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- 声明式服务调用 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 消息队列：消费课程上下架消息，同步 ES 索引 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ==================== Elasticsearch ====================
             用 RestHighLevelClient，不用 spring-boot-starter-data-elasticsearch：
             后者会把 Spring Data 的版本和 ES 客户端版本绑在一起，
             容易出现"服务端 7.17 而客户端被 Boot 管到 8.x"的错配。
             这里显式声明版本，且把 elasticsearch-rest-client 也一起锁住，
             防止 Boot 的依赖管理把它升到 8.x 造成 high-level-client 不兼容。 -->
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-high-level-client</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch</groupId>
            <artifactId>elasticsearch</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>

        <!-- 持久层：仅用于「用户兴趣」表，索引数据都在 ES -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>