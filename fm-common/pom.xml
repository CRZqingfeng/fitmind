<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fitmind</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-common</artifactId>
    <description>公共模块：统一响应、异常处理、用户上下文、工具类</description>

    <dependencies>
        <!-- JSON 处理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- 工具类库 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Web MVC：标为 provided，由使用方自行引入，
             避免给 WebFlux（网关）带来 servlet 冲突 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis-Plus 注解（@TableName / IEnum 等）：provided，由使用方引入 starter -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis-Plus 分页插件：PageQuery/PageDTO 需要 Page、OrderItem 类型。
             provided —— 使用方引入 mybatis-plus-spring-boot3-starter 后会自带 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OpenAPI 注解（@Schema）：provided，只有引了 knife4j 的服务才用得上 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- RabbitMQ 工具：provided —— 只有真正要用 MQ 的服务（fm-course / fm-search）
             才会引 amqp starter，网关等模块不受影响。
             配合 @AutoConfiguration + @ConditionalOnClass 使用，见 MqAutoConfiguration -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- XXL-JOB 执行器核心：provided —— 只有真正要执行定时任务的服务
             （fm-learning / fm-media）才引入；网关等模块 classpath 上没有它，
             下面的 XxlJobConfig 自动配置会被 @ConditionalOnClass 跳过 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job-version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
