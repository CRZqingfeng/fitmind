<?xml version="1.0" encoding="UTF-8"?>
<!--
  统一日志配置（P0-8）。

  ★ 为什么放在 fm-common 而不是各服务：
    全部 16 个服务都依赖 fm-common（网关经 fm-auth-common 间接依赖），
    一份配置即覆盖所有进程 —— 改格式不用动 16 个地方。
  ⚠️ 约定：除本文件外，任何模块都不要再放 logback-spring.xml。
    两份同时存在时"谁生效"由 classpath 顺序决定，是典型的
    "看起来改了、其实没生效"，排查成本极高。

  ★ 本文件最关键的一行是 %X{requestId}：
    链路 id 此前已经全链路打通了（网关 RequestOriginFilter 生成 →
    请求头 → 下游 RequestIdFilter 塞进 MDC → 响应体 / MQ 消息头），
    但日志格式里没有它 —— 于是"有 id"却"搜不到"。
    补上它，这条链路才真正产生价值。
    取不到时输出 "-"，避免日志出现空洞。

  ★ 日志级别不在这里写死：spring 的 logging.level.* 在 logback 配置之后生效，
    会覆盖本文件的 <logger> 设置。要改级别请改 application.yml 的
    logging.level.com.fitmind（已支持 ${FM_LOG_LEVEL:debug} 环境变量）。
-->
<configuration scan="false">

    <property name="LOG_HOME" value="${LOG_HOME:-logs}"/>
    <!--
      ★ 服务名必须用 <springProperty> 取，不能写 ${spring.application.name}：
      logback 的 ${} 只能解析"系统属性 / 环境变量 / logback 自己的 context"，
      读不到 application.yml 里的 spring.application.name —— 直接写会静默拿到默认值，
      表现成"16 个服务全叫 fitmind"，日志文件互相覆盖（实测过）。
    -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="fitmind"/>

    <!-- 控制台：本地开发看 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %5level [%X{requestId:--}] [%15.15thread] %-40.40logger{39} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      文件：按天 + 按大小滚动，保留 7 天。
      ★ 为什么一定要落盘：只打控制台时，进程一重启日志就没了，
        而"出事 → 重启 → 事后查"是最常见的排障顺序。
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5level [%X{requestId:--}] [%15.15thread] %-40.40logger{39} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 本地：控制台 + 文件都有，方便边跑边看 -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- 非 local（生产）：只落文件，避免容器 stdout 被打爆 -->
    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

</configuration>
