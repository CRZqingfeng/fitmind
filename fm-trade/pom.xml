<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fitmind</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-trade</artifactId>
    <description>交易服务：购物车、订单创建、订单状态机、超时取消</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-common</artifactId>
        </dependency>
        <!-- 跨服务契约：CourseClient（下单必须回源取课程当前价与有效期） -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-api</artifactId>
        </dependency>
        <!-- 资源服务鉴权 SDK：把网关透传的用户信息放入 UserContext -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-auth-resource-sdk</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 服务注册发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ⚠️ 即使本服务自己不写 Feign 客户端，也必须引 openfeign：
             fm-api 的 FeignOriginConfig 引用了 feign.RequestInterceptor，
             而 @SpringBootApplication(scanBasePackages="com.fitmind") 会扫到它 ——
             缺依赖会在启动时报 NoClassDefFoundError: feign/RequestInterceptor。
             这是"依赖 fm-api 就必须引 openfeign"这条契约的代价（见 FeignOriginConfig 注释）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- ⚠️ 必须显式引 loadbalancer：Spring Cloud 2020 起 openfeign 不再自带它，
             缺了会在启动时报 "No Feign Client for loadBalancing defined.
             Did you forget to include spring-cloud-starter-loadbalancer?"
             （本模块就栽在这一条上——所有用了 Feign 的模块都有这行） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 消息队列：支付成功通知（M4-2 消费）、订单完成通知学习服务（M4-2 生产） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ★ Redis：订单超时取消的延迟队列（ZSet）与下单防重锁 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ★ XXL-JOB 执行器：跑 orderTimeoutCancelJob（每分钟扫到期订单 + 兜底）
             为什么用定时任务而不是 MQ 延迟队列：见 TradeApplication 的类注释 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job-version}</version>
        </dependency>

        <!-- 持久层：order / order_detail / cart -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
