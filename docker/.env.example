# ============================================================
# FitMind 本地环境变量模板
# ------------------------------------------------------------
# 用法：cp docker/.env.example docker/.env 然后填入真实值
#
# ⚠️ docker/.env 已在 .gitignore 里，**不要提交**。
#    这个示例文件只放键名与占位符，可以安全入库。
# ============================================================

# ==================== 中间件（docker-compose 使用） ====================
REDIS_PORT=
REDIS_PASSWORD=
NACOS_PORT=
NACOS_GRPC_PORT=
NACOS_GRPC_PORT_2=
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
RABBITMQ_PORT=
RABBITMQ_CONSOLE_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ES_PORT=
ES_JAVA_OPTS=
XXL_ADMIN_PORT=
XXL_JOB_TOKEN=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ==================== 大模型（M6 fm-aigc 使用） ====================
# DeepSeek：chat 模型（OpenAI 兼容协议）
# 申请地址 https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 阿里云百炼：embedding 模型（text-embedding-v4，OpenAI 兼容协议）
# 申请地址 https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
