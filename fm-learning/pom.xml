<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitmind</groupId>
        <artifactId>fitmind</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>fm-learning</artifactId>
    <description>学习服务：课表、学习进度（分布式进度合并）、学习计划、定时任务</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-common</artifactId>
        </dependency>
        <!-- 跨服务契约：CourseClient 拿课程全文（报名校验 / 进度计算） -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-api</artifactId>
        </dependency>
        <!-- 资源服务鉴权 SDK：自动把网关透传的用户信息放入 UserContext -->
        <dependency>
            <groupId>com.fitmind</groupId>
            <artifactId>fm-auth-resource-sdk</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 服务注册发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- 声明式服务调用 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 消息队列：完成训练动作后发 section.learned 事件（M3-2 积分来源） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Redis：分布式进度合并（缓存 + ZSet 延迟队列）的核心存储 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ★ XXL-JOB 执行器：本服务要跑 lessonExpireJob。
             fm-common 的 XxlJobConfig 是 @AutoConfiguration + @ConditionalOnClass，
             引入依赖即自动装配，不用写任何配置类 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job-version}</version>
        </dependency>

        <!-- 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
